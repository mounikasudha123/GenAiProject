PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# OpenAI-compatible endpoint. Ollama example: http://localhost:11434/v1/chat/completions
LLM_BASE_URL=http://localhost:11434/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=llama3.2:3b

# Firebase Admin: set either service account JSON or Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
